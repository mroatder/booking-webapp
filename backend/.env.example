# Server
PORT=3000
NODE_ENV=development

# JWT
# production: บังคับ ≥ 32 ตัวอักษรแบบสุ่ม (สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ไม่งั้นระบบไม่เริ่มทำงาน
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ไฟล์แนบ (แบบฟอร์มขอรถ PDF/JPG/PNG) - path สัมพัทธ์จะนับจากโฟลเดอร์ backend/
# ต้องอยู่นอกโฟลเดอร์ที่ IIS เสิร์ฟ และต้องรวมในแผน backup (ไฟล์ไม่ได้อยู่ใน database)
UPLOAD_DIR=uploads

# MSSQL
# DB_HOST = ชื่อเครื่อง/เซิร์ฟเวอร์เฉยๆ (อย่าต่อ \SQLEXPRESS ต่อท้าย - ใส่แยกที่ DB_INSTANCE แทน)
# DB_NAME แนะนำให้แยก booking_project_dev / booking_project_prod ตาม environment
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=SQLEXPRESS
DB_NAME=booking_project_dev
DB_USER=booking_app
DB_PASSWORD=change-me
# production: DB_ENCRYPT=true และถ้า SQL Server มีใบรับรองที่เชื่อถือได้ให้ตั้ง DB_TRUST_SERVER_CERT=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Active Directory - production แนะนำ ldaps://host:636 (plain ldap:// ส่งรหัสผ่านพนักงานแบบไม่เข้ารหัส)
# ไม่มี admin group ให้เช็ค - ผู้ใช้ AD ทุกคน login แล้วเริ่มต้นเป็น Employee เสมอ
# Admin กำหนด role ให้เองทีหลังผ่านหน้าจัดการผู้ใช้ในเว็บ
LDAP_URL=ldap://ad.example.local:389
LDAP_BASE_DN=DC=example,DC=local
LDAP_DOMAIN=example.local
# บัญชีบริการ AD (read-only พอ) ใช้ให้ Admin ค้นหาและเพิ่มผู้ใช้จาก AD ได้โดยไม่ต้องรอผู้ใช้ login เอง
# LDAP_BIND_USER ใส่แบบ UPN (svc-booking@example.local) หรือ DN เต็มก็ได้ - เว้นว่างไว้ = ปิดฟีเจอร์นี้
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# URL ที่ผู้ใช้เปิดระบบ - ใช้ทำปุ่มลิงก์ในอีเมลแจ้งเตือน (เว้นว่าง = ไม่มีปุ่ม)
APP_BASE_URL=http://localhost:5173

# จำนวน reverse proxy หน้า backend (IIS ARR = 1) เพื่อให้ IP ใน audit log และตัวจำกัดล็อกอินเป็น IP ผู้ใช้จริง - เว้นว่าง = ไม่เชื่อ X-Forwarded-For
TRUST_PROXY=

# จำกัดการล็อกอินผิด: ผิดเกินกี่ครั้งต่อ username ภายในกี่นาที จึงถูกบล็อก (ตอบ 429)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# SMTP - แจ้งเตือนทางอีเมลอย่างเดียว (ค่าจริงใส่ใน backend/.env เท่านั้น ห้ามใส่ในไฟล์นี้)
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = SSL ตั้งแต่ต้น (SMTP_SECURE=true), 25 = ไม่เข้ารหัส/ภายใน
SMTP_PORT=587
SMTP_SECURE=false
# บัญชีสำหรับ login ส่งเมล - เว้นว่างทั้งคู่ถ้าเซิร์ฟเวอร์อนุญาตให้ส่งได้โดยไม่ต้อง login
SMTP_USER=
SMTP_PASSWORD=
# ผู้ส่ง - ต้องเป็นกล่องจดหมายที่มีอยู่จริง (ปกติตรงกับ SMTP_USER)
SMTP_FROM="ระบบจองห้องประชุมและรถ" <noreply@example.local>
# เซิร์ฟเวอร์เมลใช้ใบรับรองที่ออกเอง (self-signed) → pin ใบรับรอง (ห้ามปิดการตรวจใบรับรอง)
# SMTP_CA_FILE = ไฟล์ใบรับรองราก (เก็บใน backend/certs/ ซึ่งไม่ถูก commit), SMTP_TLS_FINGERPRINT = SHA-256 ของใบรับรองเซิร์ฟเวอร์
# ถ้าเซิร์ฟเวอร์เมลมีใบรับรองที่ถูกต้องแล้ว เว้นว่างทั้งคู่
SMTP_CA_FILE=
SMTP_TLS_FINGERPRINT=
# dev/ทดสอบเท่านั้น: ส่งอีเมลทุกฉบับไปที่อีเมลนี้แทนผู้รับจริง (หัวเรื่องบอกผู้รับตัวจริง) - production ต้องเว้นว่าง
MAIL_REDIRECT_TO=

